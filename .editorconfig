[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 160
tab_width = 4
ij_visual_guides = 80,120

[*.ps1]
indent_style = tab
end_of_line = crlf

[{*.py,*.pyw}]
ij_python_blank_line_at_file_end = true
ij_python_blank_lines_around_class = 2
